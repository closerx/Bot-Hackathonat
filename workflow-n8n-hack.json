      "parameters": {
        "jsCode": "// استخراج مصفوفة البيانات من جسم الـ Webhook\nconst rawData = $input.first().json.body || [];\n\nlet combinedText = \"📌 *جديد التحديثات*\\n\";\ncombinedText += \"───────────────────\\n\\n\";\n\nlet validCount = 0;\n\nrawData.forEach((item) => {\n  // يتجاهل الرسائل الفارغة التي لا تحتوي على وصف\n  if (item.description && item.description.trim() !== \"\") {\n    validCount++;\n    \n    // تم حذف سطر القناة من هنا\n    combinedText += `📝 *الوصف:*\\n${item.description.trim()}\\n`;\n    \n    if (item.link && item.link.trim() !== \"\") {\n      combinedText += `\\n🔗 *الرابط:* ${item.link.trim()}\\n`;\n    }\n    \n    combinedText += \"\\n───────────────────\\n\\n\";\n  }\n});\n\n// في حال عدم وجود أي محتوى نصي\nif (validCount === 0) {\n  combinedText = \"⚠️ لا توجد تحديثات نصية جديدة في هذه الدورة.\";\n}\n\n// إرجاع عنصر واحد يحتوي على النص الجاهز للإرسال\nreturn [\n  {\n    json: {\n      text: combinedText.trim()\n    }\n  }\n];\n"
      },
